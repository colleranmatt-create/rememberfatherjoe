# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key (or a "secret" key, sb_secret_...). Server-only: never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin, where memories are approved
ADMIN_PASSWORD=

# Public address of the site, used for link previews
NEXT_PUBLIC_SITE_URL=https://rememberfatherjoe.com
